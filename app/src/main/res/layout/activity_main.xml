<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="SelfieStick"
                android:textColor="#F3F4F6"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- status and the two main actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textColor="#F3F4F6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/grant_state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8B93A1"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connect_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:minHeight="44dp"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="#0E1116"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/grant_vpn_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:minHeight="44dp"
                    android:text="Grant VPN"
                    android:textAllCaps="false"
                    android:textColor="#E5E7EB" />
            </LinearLayout>
        </LinearLayout>

        <!-- connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local port"
                        android:textColor="#8B93A1"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/local_port_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_input"
                        android:inputType="number"
                        android:maxLength="5"
                        android:minHeight="40dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="#F3F4F6"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="adbd port"
                        android:textColor="#8B93A1"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/port_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_input"
                        android:inputType="number"
                        android:maxLength="5"
                        android:minHeight="40dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="#F3F4F6"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Launch command"
                android:textColor="#8B93A1"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/command_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="am start -n com.example/.MainActivity"
                android:inputType="textMultiLine"
                android:minHeight="40dp"
                android:minLines="2"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#F3F4F6"
                android:textColorHint="#4B5563"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <Switch
                android:id="@+id/boot_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Connect on boot"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

                        <Switch
                android:id="@+id/localhost_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Connect via localhost (no VPN)"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/wide_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Wide VPN fallback"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/secure_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Write secure settings (grant over adb, turn adb on)"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/adb_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Turn on adb at run start"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/wifi_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Turn on wireless adb at run start"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/a11y_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Auto-enable early-start accessibility"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/secure_state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="8dp"
                android:textColor="#8B93A1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/early_start_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingBottom="8dp"
                android:textColor="#8B93A1"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/debug_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Debug log"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
